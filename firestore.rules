rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // כל משפחה = מסמך אחד, שהמזהה שלו הוא קוד המשפחה (6 תווים)
    match /families/{code} {
      allow get: if request.auth != null;
      allow list, delete: if false; // אי אפשר לדפדף בין משפחות או למחוק
      allow create, update: if request.auth != null
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['name', 'gender', 'words', 'history', 'soundOn', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30
        && request.resource.data.words is list
        && request.resource.data.words.size() <= 500
        && request.resource.data.history is list
        && request.resource.data.history.size() <= 30;
    }
  }
}
